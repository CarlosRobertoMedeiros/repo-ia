# Copie para .env e preencha. O .env não deve ir para o git.

# Token de acesso de usuário (ou de longa duração) com as permissões
# instagram_basic, pages_show_list e business_management.
META_ACCESS_TOKEN=

# Opcional: ID da SUA conta profissional do Instagram. Se vazio, é descoberto pelo token.
META_IG_USER_ID=

# Opcional: versão da API Graph.
META_GRAPH_VERSION=v23.0
