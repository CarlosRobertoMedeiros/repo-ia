# Modelo de configuração do MCP video-transcricao.
# Copie para .env (na mesma pasta) e preencha GROQ_API_KEY. O .env não vai para o git.

# Chave de API (obrigatória). Crie em https://console.groq.com/keys
GROQ_API_KEY=

# Endpoint compatível com OpenAI. Só mude se usar proxy/gateway.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# whisper-large-v3 (mais preciso) ou whisper-large-v3-turbo (mais rápido e barato)
GROQ_TRANSCRIBE_MODEL=whisper-large-v3

# Idioma falado padrão (pt, en, es...). Vazio = detecção automática.
TRANSCRICAO_IDIOMA=

# 0 a 1. 0 = mais fiel ao áudio.
TRANSCRICAO_TEMPERATURA=0

# Vocabulário opcional para guiar a grafia (nomes próprios, marcas, termos técnicos).
TRANSCRICAO_PROMPT=

# Bitrate do áudio extraído (Opus mono 16 kHz), em kbit/s, entre 12 e 64.
TRANSCRICAO_AUDIO_KBPS=24

# Tamanho máximo (MB) de cada arquivo enviado (a Groq aceita até 25).
TRANSCRICAO_LIMITE_MB=24

# Duração máxima de cada parte, em segundos (0 = só o tamanho conta).
TRANSCRICAO_MAX_SEGUNDOS=0

# Tentativas em falhas temporárias (429, 5xx, rede).
TRANSCRICAO_TENTATIVAS=4
