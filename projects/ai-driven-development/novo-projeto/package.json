{
  "name": "novo-projeto",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "@types/jest": "^30.0.0",
    "jest": "^29.7.0",
    "prettier": "3.9.6",
    "ts-jest": "^29.4.15",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*"
  ]
}
