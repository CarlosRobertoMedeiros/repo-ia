{
  "name": "@sdd/arquitetura-de-engenharia-agentica",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "ts-node": "^10.9.2",
    "turbo": "^2.11.11",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.19.1"
    }
  },
  "workspaces": [
    "apps/*",
    "modules/*",
    "packages/*"
  ]
}
